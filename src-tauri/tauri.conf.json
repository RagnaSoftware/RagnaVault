{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RagnaVault",
  "version": "3.0.0",
  "identifier": "net.ragnasoftware.ragnavault",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RagnaVault",
        "width": 1120,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "center": true,
        "contentProtected": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "RagnaSoftware",
    "copyright": "© 2026 RagnaSoftware",
    "shortDescription": "Passwort-Manager und 2FA-Authenticator",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
